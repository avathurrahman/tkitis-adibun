# Update these with your Supabase details from your project settings > API
# https://app.supabase.com/project/_/settings/api
NEXT_PUBLIC_SUPABASE_URL=your-project-url
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=your-publishable-or-anon-key
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# Feature toggles (optional; set to false for features you do not use)
NEXT_PUBLIC_ENABLE_AUTH=true
NEXT_PUBLIC_ENABLE_WAITLIST=true
NEXT_PUBLIC_ENABLE_CONTACT=true
NEXT_PUBLIC_ENABLE_PAYMENTS=true
NEXT_PUBLIC_ENABLE_ADMIN=true
NEXT_PUBLIC_ENABLE_AI=true

PAYMENT_PROVIDER=doku               # or "midtrans"

# DOKU (when PAYMENT_PROVIDER=doku and payments are enabled)
DOKU_CLIENT_ID=
DOKU_SECRET_KEY=

# Midtrans (when PAYMENT_PROVIDER=midtrans and payments are enabled)
MIDTRANS_SERVER_KEY=
NEXT_PUBLIC_MIDTRANS_CLIENT_KEY=

NEXT_PUBLIC_APP_URL=http://localhost:3000

# Email (Resend, when contact form is enabled)
RESEND_API_KEY=
EMAIL_FROM=KilatKoding <noreply@yourdomain.com>

# Admin
ADMIN_EMAILS=you@example.com

# AI (optional — only needed if AI features enabled)
AI_DEFAULT_PROVIDER=openai          # or "anthropic"
OPENAI_API_KEY=
ANTHROPIC_API_KEY=
